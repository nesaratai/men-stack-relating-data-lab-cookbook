<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>My Pantry</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <p><a href="/">Home</a> - Foods</p>
    <div class="all-apps-body">
        <div class="all-apps-header">
          <h1>Welocme to my favorite food Recipe</h1>
          <ul>
            <% foods.forEach(food => { %>
              <li>
                <strong><a href="/foods/<%= food._id %>"><%= food.Title %></a></strong> — <%= food.MealType %>
              </li>
            <% }) %>
          </ul>
    <a href="/foods/new">Add Your Recipe</a>
</div>
</div>
  </body>
</html>
