<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <title>Home Page</title>
</head>
<body>
  <%- include('./partials/_navbar.ejs') %>
  <% if (user) { %>
    <h1>Welcome to the app, <%= user.username %>!</h1>
    <p>
      <a href="/auth/sign-out" class="btn">Sign out</a>
      <a href="/foods" class="btn">My Pantry</a>
    </p>
  <% } else { %>
    <h1>Welcome to the app, guest.</h1>
    <p class="auth-links">
      <a href="/auth/sign-up" class="btn">Sign up</a>
      <span>or</span>
      <a href="/auth/sign-in" class="btn btn-secondary">Sign in</a>
    </p>
  <% } %>

  <p><a href="/vip-lounge" class="btn btn-vip">Get into the VIP Users Only lounge!</a></p>
</body>
</html>
